generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String? // null for Google-only signups
  providers     Provider[] @default([EMAIL])
  googleId      String?    @unique
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())

  verificationTokens VerificationToken[]
  invoices           Invoice[]
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id               String           @id @default(uuid())
  userId           String
  gstin            String
  invoiceNumber    String?
  invoiceDate      DateTime?
  invoiceDateRaw   String?
  vendorName       String?
  amount           Decimal?         @db.Decimal(12, 2)
  extractionStatus ExtractionStatus
  summaryStatus    SummaryStatus    @default(PENDING)
  summary          String?
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  validationResults ValidationResult[]

  @@index([userId, extractionStatus])
}

model ValidationResult {
  id        String   @id @default(uuid())
  invoiceId String
  runAt     DateTime
  ruleCode  String
  passed    Boolean
  severity  Severity
  message   String
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, runAt])
}

enum Severity {
  ERROR
  WARNING
}

enum ExtractionStatus {
  COMPLETE
  FAILED
  NEEDS_CORRECTION
}

enum FailureReason {
  CORRUPTED_FILE
  UNREADABLE_SCAN
  MISSING_REQUIRED_FIELDS
}

enum Provider {
  EMAIL
  GOOGLE
}

enum SummaryStatus {
  PENDING
  COMPLETE
  FAILED
}
